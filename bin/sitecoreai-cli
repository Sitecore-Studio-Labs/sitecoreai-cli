#!/usr/bin/env node

// Dynamic import, not a static one: this file has no extension, so Node
// decides its module type from the shebang path rather than package.json
// `type`, and treats it as CommonJS. `import()` is valid in both module
// systems, so this entry works either way and stays correct if Node's
// extensionless handling ever changes.
import("../dist/esm/cli.js").catch((error) => {
  console.error(error);
  process.exit(1);
});
