{
  "compilerOptions": {
    "target": "ES2020",
    // Runtime is Node >=22.12 (see package.json engines), which is fully
    // ES2022+. Surface those lib types (e.g. the `Error(message, { cause })`
    // constructor) without changing the ES2020 downlevel-emit target.
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": false
  },
  "include": ["src"]
}
