{
  "name": "@sitecoreai-labs/sitecoreai-cli",
  "version": "0.3.2",
  "description": "SitecoreAI developer toolkit — a native TypeScript CLI, SDK, and MCP server for deploy, serialization, recipes, publishing, and content operations.",
  "license": "MIT",
  "type": "commonjs",
  "author": "Liz Nelson <liz.nelson@sitecore.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sitecore-Studio-Labs/sitecoreai-cli.git"
  },
  "homepage": "https://github.com/Sitecore-Studio-Labs/sitecoreai-cli",
  "bugs": {
    "url": "https://github.com/Sitecore-Studio-Labs/sitecoreai-cli/issues"
  },
  "bin": {
    "sitecoreai-cli": "bin/sitecoreai-cli",
    "scai": "bin/sitecoreai-cli"
  },
  "exports": {
    "./recipe": {
      "types": "./dist/recipe/index.d.ts",
      "default": "./dist/recipe/index.js"
    },
    "./recipe/unstable": {
      "types": "./dist/recipe/unstable.d.ts",
      "default": "./dist/recipe/unstable.js"
    },
    "./deploy": {
      "types": "./dist/deploy/index.d.ts",
      "default": "./dist/deploy/index.js"
    },
    "./serialization": {
      "types": "./dist/serialization/index.d.ts",
      "default": "./dist/serialization/index.js"
    },
    "./errors": {
      "types": "./dist/shared/errors.d.ts",
      "default": "./dist/shared/errors.js"
    },
    "./envelope": {
      "types": "./dist/shared/envelope.d.ts",
      "default": "./dist/shared/envelope.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "default": "./dist/config/index.js"
    },
    "./publishing": {
      "types": "./dist/publishing/index.d.ts",
      "default": "./dist/publishing/index.js"
    },
    "./content": {
      "types": "./dist/content/index.d.ts",
      "default": "./dist/content/index.js"
    },
    "./hygiene": {
      "types": "./dist/hygiene/index.d.ts",
      "default": "./dist/hygiene/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "default": "./dist/webhooks/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "default": "./dist/sync/index.js"
    },
    "./unstable/agents": {
      "types": "./dist/agents/index.d.ts",
      "default": "./dist/agents/index.js"
    },
    "./unstable/brand": {
      "types": "./dist/brand/index.d.ts",
      "default": "./dist/brand/index.js"
    },
    "./unstable/brief": {
      "types": "./dist/brief/index.d.ts",
      "default": "./dist/brief/index.js"
    },
    "./unstable/campaigns": {
      "types": "./dist/campaigns/index.d.ts",
      "default": "./dist/campaigns/index.js"
    },
    "./unstable/scripting": {
      "types": "./dist/scripting/index.d.ts",
      "default": "./dist/scripting/index.js"
    },
    "./unstable/sites": {
      "types": "./dist/sites/index.d.ts",
      "default": "./dist/sites/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "dist",
    "AGENTS.md",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc-alias && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/recipe/sandbox',{recursive:true});fs.copyFileSync('src/recipe/sandbox/recipe-runner.cjs','dist/recipe/sandbox/recipe-runner.cjs')\"",
    "changeset": "changeset",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx -r tsconfig-paths/register src/cli.ts",
    "docs:commands": "tsx scripts/generate-commands-doc.ts",
    "scan:agentic-actions": "tsx -r tsconfig-paths/register scripts/scan-agentic-actions.ts",
    "record:agentic-actions": "tsx -r tsconfig-paths/register scripts/record-agentic-actions.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "mcpb:pack": "npx -y @anthropic-ai/mcpb@2 validate mcpb/manifest.json && npx -y @anthropic-ai/mcpb@2 pack mcpb scai.mcpb",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc-alias && node -e \"const fs=require('node:fs');fs.mkdirSync('dist/recipe/sandbox',{recursive:true});fs.copyFileSync('src/recipe/sandbox/recipe-runner.cjs','dist/recipe/sandbox/recipe-runner.cjs')\" && changeset publish",
    "sites:codegen": "openapi-typescript src/sites/api/openapi.yaml --output src/sites/api/schema.d.ts",
    "brand:codegen": "openapi-typescript src/brand/api/openapi.brand-management.yaml --output src/brand/api/schema.brand-management.d.ts && openapi-typescript src/brand/api/openapi.brand-review.yaml --output src/brand/api/schema.brand-review.d.ts && openapi-typescript src/brand/api/openapi.documents.yaml --output src/brand/api/schema.documents.d.ts && openapi-typescript src/brand/api/openapi.pipeline.yaml --output src/brand/api/schema.pipeline.d.ts",
    "smoke": "npm run build && node scripts/smoke.cjs && node scripts/smoke-exports.cjs && node scripts/smoke-mcp.cjs",
    "start": "node dist/cli.js",
    "pretest": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "version": "changeset version",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.cjs",
    "coverage:ratchet:raise": "RAISE_RATCHET=1 node scripts/check-coverage-ratchet.cjs"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "adm-zip": "^0.5.16",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "consola": "^3.4.2",
    "dotenv": "^17.2.3",
    "esbuild": "^0.28.1",
    "fast-glob": "^3.3.3",
    "ora": "^9.1.0",
    "tsx": "^4.21.0",
    "uuid": "^14.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "overrides": {
    "fast-uri": "^3.1.2",
    "picomatch": "^2.3.2",
    "hono": "^4.12.25",
    "esbuild": "^0.28.1",
    "vite": "^7.3.5",
    "js-yaml": "^4.2.0",
    "read-yaml-file": {
      "js-yaml": "^3.6.1"
    }
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.2",
      "picomatch": "^2.3.2",
      "hono": "^4.12.25",
      "esbuild": "^0.28.1",
      "vite": "^7.3.5",
      "js-yaml": "^4.2.0"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.2",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^25.9.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.35.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.18"
  },
  "optionalDependencies": {
    "playwright-core": "^1.60.0"
  }
}
