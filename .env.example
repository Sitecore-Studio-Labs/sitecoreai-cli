# Telemetry overrides (settings.telemetryEnabled is in sitecoreai.cli.json)
# SITECOREAI_TELEMETRY=true
# SITECOREAI_TELEMETRY=false
# SITECOREAI_TELEMETRY_URL=https://telemetry-api-ten.vercel.app/v1/t
# SITECOREAI_TELEMETRY_TIMEOUT_MS=5000
# SITECOREAI_TELEMETRY_RETRIES=1
# SITECOREAI_TELEMETRY_RETRY_BASE_MS=250
# DISABLE_TELEMETRY=1
# DO_NOT_TRACK=1

# Config overrides (global envProfiles fields)
# SITECOREAI_CM_HOST=https://your-cm-host
# SITECOREAI_AUTHORITY=https://auth.sitecorecloud.io
# SITECOREAI_AUDIENCE=https://api.sitecorecloud.io
# SITECOREAI_CLIENT_ID=
# SITECOREAI_CLIENT_SECRET=
# SITECOREAI_DEPLOY_TOKEN= # SitecoreAI access token (Deploy + CM/admin scopes)
# SITECOREAI_ORGANIZATION_ID=
# SITECOREAI_TENANT_ID=
# SITECOREAI_PROJECT_ID=
# SITECOREAI_ENVIRONMENT_ID=
# SITECOREAI_ALLOW_WRITE=true
# SITECOREAI_USE_CLIENT_CREDENTIALS=true

# Config overrides (per environment envProfiles fields)
# SITECOREAI_ENV_DEMO_CM_HOST=https://demo-cm
# SITECOREAI_ENV_DEMO_AUTHORITY=https://auth.sitecorecloud.io
# SITECOREAI_ENV_DEMO_AUDIENCE=https://api.sitecorecloud.io
# SITECOREAI_ENV_DEMO_CLIENT_ID=
# SITECOREAI_ENV_DEMO_CLIENT_SECRET=
# SITECOREAI_ENV_DEMO_DEPLOY_TOKEN=
# SITECOREAI_ENV_DEMO_ORGANIZATION_ID=
# SITECOREAI_ENV_DEMO_TENANT_ID=
# SITECOREAI_ENV_DEMO_PROJECT_ID=
# SITECOREAI_ENV_DEMO_ENVIRONMENT_ID=
# SITECOREAI_ENV_DEMO_ALLOW_WRITE=true
# SITECOREAI_ENV_DEMO_USE_CLIENT_CREDENTIALS=true

# Config-only settings (set in sitecoreai.cli.json)
# settings.cacheAuthenticationToken
# settings.versionComparisonEnabled
# settings.apiClientTimeoutInMinutes

# History log override
# SITECOREAI_HISTORY_PATH=/custom/path/cli-history.log

# Integration test envs
# SITECOREAI_RUN_INTEGRATION=1
# SITECOREAI_DEPLOY_TOKEN=
# SITECOREAI_CLIENT_ID=
# SITECOREAI_CLIENT_SECRET=
# SITECOREAI_AUTHORITY=https://auth.sitecorecloud.io
# SITECOREAI_AUDIENCE=https://api.sitecorecloud.io
# DEPLOY_BASE_URL=
# DEPLOY_ORG_ID=
# DEPLOY_PROJECT_ID=
# DEPLOY_ENVIRONMENT_ID=
# DEPLOY_DEPLOYMENT_ID=
# DEPLOY_PROMOTE_SOURCE_DEPLOYMENT_ID=
# DEPLOY_LOG_FILE=
# DEPLOY_EDITING_HOST_CM_ENVIRONMENT_ID=
# DEPLOY_EDITING_HOST_NAME=
# DEPLOY_ENABLE_WRITES=0
