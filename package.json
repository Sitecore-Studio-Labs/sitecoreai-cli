{
  "name": "@sitecoreai-labs/sitecoreai-cli",
  "version": "0.0.4",
  "description": "SitecoreAI Deploy & Sync CLI for serialization and deployment workflows",
  "license": "MIT",
  "type": "commonjs",
  "author": "Liz Nelson <liz.nelson@sitecore.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sitecore-studio-labs/sitecoreai-cli.git"
  },
  "homepage": "https://github.com/sitecore-studio-labs/sitecoreai-cli",
  "bugs": {
    "url": "https://github.com/sitecore-studio-labs/sitecoreai-cli/issues"
  },
  "bin": {
    "sitecoreai-cli": "bin/sitecoreai-cli",
    "scai": "bin/sitecoreai-cli"
  },
  "exports": {
    "./recipe": {
      "types": "./dist/recipe/index.d.ts",
      "default": "./dist/recipe/index.js"
    },
    "./deploy": {
      "types": "./dist/deploy/api/index.d.ts",
      "default": "./dist/deploy/api/index.js"
    },
    "./serialization": {
      "types": "./dist/serialization/sitecore-api/index.d.ts",
      "default": "./dist/serialization/sitecore-api/index.js"
    },
    "./errors": {
      "types": "./dist/shared/errors.d.ts",
      "default": "./dist/shared/errors.js"
    },
    "./brand": {
      "types": "./dist/brand/index.d.ts",
      "default": "./dist/brand/index.js"
    },
    "./sites": {
      "types": "./dist/sites/index.d.ts",
      "default": "./dist/sites/index.js"
    },
    "./publishing": {
      "types": "./dist/publishing/index.d.ts",
      "default": "./dist/publishing/index.js"
    },
    "./hygiene": {
      "types": "./dist/hygiene/index.d.ts",
      "default": "./dist/hygiene/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks/index.d.ts",
      "default": "./dist/webhooks/index.js"
    },
    "./workflow": {
      "types": "./dist/workflow/index.d.ts",
      "default": "./dist/workflow/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin",
    "dist",
    "AGENTS.md",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc-alias",
    "changeset": "changeset",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx -r tsconfig-paths/register src/cli.ts",
    "docs:commands": "tsx scripts/generate-commands-doc.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "prepare": "husky",
    "release": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc-alias && changeset publish",
    "sites:codegen": "openapi-typescript src/sites/api/openapi.yaml --output src/sites/api/schema.d.ts",
    "brand:codegen": "openapi-typescript src/brand/api/openapi.brand-management.yaml --output src/brand/api/schema.brand-management.d.ts && openapi-typescript src/brand/api/openapi.brand-review.yaml --output src/brand/api/schema.brand-review.d.ts",
    "smoke": "npm run build && node scripts/smoke.cjs && node scripts/smoke-mcp.cjs",
    "start": "node dist/cli.js",
    "pretest": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "version": "changeset version"
  },
  "lint-staged": {
    "*.{ts,tsx,js,cjs,mjs}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/keyring": "^1.3.0",
    "adm-zip": "^0.5.16",
    "ajv": "^8.17.1",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "commander": "^12.1.0",
    "consola": "^3.4.2",
    "dotenv": "^17.2.3",
    "fast-glob": "^3.3.3",
    "ora": "^9.1.0",
    "tsx": "^4.21.0",
    "uuid": "^14.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^2.3.2"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@eslint/js": "^9.39.2",
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.35.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.6.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^4.0.18"
  }
}
